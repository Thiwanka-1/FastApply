NODE_ENV=development
PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173
CHROME_EXTENSION_ORIGIN=chrome-extension://YOUR_EXTENSION_ID

# ... existing variables ...
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id_here

# Agent 1 and Agent 2
LLM_PROVIDER=huggingface
HF_API_KEY=
HF_BASE_URL=https://router.huggingface.co/v1
HF_EXTRACTION_MODEL=
HF_WRITING_MODEL=
HF_VISION_MODEL=
HF_PROFILE_MAX_TOKENS=5500
HF_WRITING_MAX_TOKENS=3000
HF_VISION_BATCH_MAX_TOKENS=5500
HF_VISION_RECOVERY_MAX_TOKENS=3500
LLM_REQUEST_TIMEOUT=120000

# Optional local Ollama alternative
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_NUM_CTX=32768

# Password-reset email (any SMTP works; a free Gmail app password is easiest:
# Google Account -> Security -> 2-Step Verification -> App passwords).
# Leave unset in development to have reset codes printed to the server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FastApply <no-reply@fastapply.local>"
